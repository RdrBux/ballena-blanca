---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
---

<header class="absolute inset-0 w-full h-fit z-10 border-b border-white/10">
	<div class="container max-w-7xl mx-auto px-4 py-2 h-20 flex items-center gap-4 justify-between">
		<a href="/#" class="flex items-center gap-2">
			<Image src={logo} alt="Estudio Ballena Blanca" width={52} height={52} />
			<p class="text-lg font-semibold">
				Estudio Ballena Blanca
			</p>
		</a>

		<nav>
			<ul class="flex items-center gap-10">
				<li>
					<a class="py-2 text-white/50 text-sm font-medium hover:text-white duration-300" href="/#servicios">SERVICIOS</a>
				</li>
				<li>
					<a class="py-2 text-white/50 text-sm font-medium hover:text-white duration-300" href="/#portfolio">TRABAJOS</a>
				</li>
				<li>
					<a class="relative group/nav py-3 px-6 text-primary-500 border border-primary-500 bg-primary-500/10 text-sm font-medium" href="/#contacto">
						CONTACTO
						<div aria-hidden class="bg-transparent group-hover/nav:bg-primary-500/15 duration-300 absolute inset-0 -z-10 blur-xl"></div>
					</a>
				</li>
			</ul>
		</nav>
	</div>
</header>